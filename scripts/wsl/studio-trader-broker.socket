[Unit]
Description=Studio Trading 212 order broker socket (docs/t212-broker.md)

[Socket]
# systemd (root) creates the socket with exactly these permissions before the broker starts: only the broker's
# user and members of studio-broker (the OS user that runs Studio) can connect. Installed by
# scripts/wsl/install-t212-broker.sh.
ListenStream=/run/studio-trader/broker.sock
SocketUser=studio-trader
SocketGroup=studio-broker
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes
Accept=no

[Install]
WantedBy=sockets.target
