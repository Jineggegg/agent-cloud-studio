[Unit]
Description=Studio Trading 212 order broker (holds the order key; docs/t212-broker.md)
Requires=studio-trader-broker.socket
After=studio-trader-broker.socket network-online.target
Wants=network-online.target

[Service]
Type=simple
# Installed by scripts/wsl/install-t212-broker.sh. The program, its Node binary and its modules are a root-owned
# copy under /opt/studio-trader, so neither this user nor Studio's user can change the code that holds the key.
User=studio-trader
Group=studio-trader
WorkingDirectory=/var/lib/studio-trader
Environment=STUDIO_TRADER_STATE_DIR=/var/lib/studio-trader
Environment=NODE_ENV=production
ExecStart=/opt/studio-trader/bin/node /opt/studio-trader/app/main.js serve
Restart=on-failure
RestartSec=5
UMask=0077
# No core dumps: they could contain the key.
LimitCORE=0

# Hardening. Everything is read-only except the state directory; home directories are invisible.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/studio-trader
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
# MemoryDenyWriteExecute is left off on purpose: Node's JIT needs writable executable memory.

[Install]
WantedBy=multi-user.target
