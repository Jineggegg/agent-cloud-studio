# Agent Cloud Studio (modified CloudCLI UI)
# The built preview and development runner use separate ports and databases.
SERVER_PORT=3002
VITE_PORT=5174
HOST=127.0.0.1
DATABASE_PATH=.data/auth.db

# Optional inherited Claude CLI path.
# CLAUDE_CLI_PATH=claude
VITE_CONTEXT_WINDOW=160000
CONTEXT_WINDOW=160000

# Studio integrations. API keys are provisioned in the local UI or kept in
# separate key files; never put a secret value in this file.
STUDIO_SNR_BASE_URL=http://127.0.0.1:8768
# Only when SNR runs with SNR_LAB_USER/SNR_LAB_PASSWORD: the same user name and
# the path of a chmod 600 file that holds just the password (read per request).
STUDIO_SNR_USER=
STUDIO_SNR_PASSWORD_FILE=
# Two front doors, one backend (docs/network.md). Each value is an exact origin:
# https://host[:port], no path. Both doors reach this same server and database.
# A malformed value only disables what needs that door (Settings says so).
# Public door (the default): your domain behind a Cloudflare Tunnel, ideally
# with Cloudflare Access in front, e.g. https://studio.ajarche.com.
STUDIO_PUBLIC_ORIGIN=
# Tailscale door: Tailscale Serve on this machine, e.g.
# https://your-machine.your-tailnet.ts.net:8443. Passwordless Tailscale sign-in
# accepts only pages from this origin, and its sessions work only through it;
# when it is unset, STUDIO_PUBLIC_ORIGIN is used instead (the older single-door
# setup).
STUDIO_TAILNET_ORIGIN=
# Optional: let Studio itself verify Cloudflare Access on the public door. Set
# both, or neither: the Zero Trust team (myteam or myteam.cloudflareaccess.com)
# and the Access application's Audience (AUD) tag (several: comma-separated).
# Then every request through Cloudflare must carry a valid
# Cf-Access-Jwt-Assertion or gets 403 (except GET /health, /manifest.json and
# /icons/*); tailnet and local requests are not affected. Only one of the two
# set refuses every request through Cloudflare.
STUDIO_CF_ACCESS_TEAM_DOMAIN=
STUDIO_CF_ACCESS_AUD=
# Optional passwordless sign-in for your own Tailscale identity when Studio is
# opened through Tailscale Serve (https://...ts.net). Comma-separated Tailscale
# login names, e.g. you@example.com or name@github; empty disables it. Everyone
# else, including other tailnet members, still sees the password form.
# The identity names an account, not a device: every program (not only the
# browser) on every untagged device signed in as these logins gets a session.
STUDIO_TAILSCALE_LOGINS=
# Recommended: comma-separated tailnet addresses (100.x and fd7a:115c:a1e0:...)
# of the only devices allowed, e.g. your iPad; empty allows every device of the
# logins above. One invalid entry refuses every device.
STUDIO_TAILSCALE_NODES=
# Studio username those identities sign in as; empty means the only account.
STUDIO_TAILSCALE_USER=
# Optional existing subscription workbench URL. No credentials belong here.
STUDIO_AGENT_WORKBENCH_URL=
# Optional standalone SNR URL.
STUDIO_SNR_REMOTE_URL=

# Default workspaces for the built-in projects (absolute paths inside the
# workspace root, normally your home directory). Empty uses ~/projects/<name>
# when that folder exists.
STUDIO_SUPER_PROFESSOR_PATH=
STUDIO_SNR_PATH=
STUDIO_TRADING212_PATH=

# Quick-browse websites shown on the built-in Super Professor project:
# "label=url; label=url". Sites that forbid framing open in a new tab.
STUDIO_SUPER_PROFESSOR_LINKS=

# SSH hosts that projects may run agents on (reached over Tailscale with your
# own ~/.ssh/config). A JSON array on one line, no quotes around it:
# [{"name":"aj","label":"AJ server","target":"sp-remote","dir":"~/projects/app"}]
# "target" is an ssh host alias; "dir" (optional) adds a built-in project.
STUDIO_SSH_HOSTS=

# Home-screen quota widgets. Defaults: ~/.claude/studio-rate-limits.json and
# $CODEX_HOME/sessions (":"-separated list).
STUDIO_CLAUDE_RATE_FILE=
STUDIO_CODEX_SESSIONS_DIRS=

# Read-only Trading 212 module. Each path points at a .env-style file holding
# TRADING212_API_KEY and TRADING212_API_SECRET for that environment. The key is
# read by the server per request and never sent to the browser.
STUDIO_T212_ENV_FILE=
STUDIO_T212_DEMO_ENV_FILE=
# Minutes between balance snapshots for the equity curve (0 disables).
STUDIO_T212_SNAPSHOT_MINUTES=30

# Optional DeepSeek key file (a .env-style file containing DEEPSEEK_API_KEY),
# read per request on the server when no key was saved in Studio's Settings.
STUDIO_DEEPSEEK_ENV_FILE=

# Optional read-only Gmail project module. Configure Google OAuth on the server only.
# Google calls back to the door the connection was started from, so register
# <door>/api/studio/gmail/callback for STUDIO_PUBLIC_ORIGIN and STUDIO_TAILNET_ORIGIN.
STUDIO_GMAIL_CLIENT_ID=
STUDIO_GMAIL_CLIENT_SECRET=

# Mail accounts (Settings → 邮箱账户), read-only. Gmail needs no server setting: it is added
# with a Google App Password over IMAP. Outlook.com needs the Application (client) ID of your
# own free Microsoft Entra app (personal Microsoft accounts, "Allow public client flows" on,
# Graph delegated Mail.Read + User.Read). It is a public client: no secret. See docs/mail.md.
STUDIO_OUTLOOK_CLIENT_ID=
